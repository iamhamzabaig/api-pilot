node_modules/
dist/
coverage/
*.tsbuildinfo
*.log

# API Pilot workspace caches (responses, history, spec cache) — at any depth,
# so the workspace under examples/ is covered too.
**/.apipilot/.cache/
**/.apipilot/environments.local.yaml

# Scratch specs downloaded for a local check against something real. A private
# API's spec carries internal hostnames and paths, so all three extensions are
# ignored rather than only the one the committed fixtures happen to use.
tests/fixtures/specs/local-*.yaml
tests/fixtures/specs/local-*.yml
tests/fixtures/specs/local-*.json

# Machine-local agent permissions, not shared config.
.claude/settings.local.json

.DS_Store
Thumbs.db
