exports[`describe golden output > renders createCustomer 1`] = `
"POST /v1/customers
Creates a new customer object.
id: createCustomer · tags: Customers · auth: bearerAuth (http: bearer)

body (application/json, required):
  {
    email?: string(email)
    name?: string
    metadata?: { [key: string]: string }
  }

responses:
  200 application/json
    {
      created: number
      updated?: number | null
      id: string
      email: string(email)
      name?: string | null
      balance?: number
      metadata?: { [key: string]: string }
    }
  others: 400"
`;

exports[`describe golden output > renders createInvoice 1`] = `
"POST /v1/invoices
This endpoint creates a draft invoice for a given customer.
id: createInvoice · tags: Invoices · auth: bearerAuth (http: bearer)

body (application/json, required):
  {
    customer: string
    auto_advance?: boolean
    description?: string | null
  }

responses:
  200 application/json
    {
      id: string
      customer: string
      status: "draft" | "open" | "paid" | "uncollectible" | "void"
      amount_due?: number
      lines?: array of {
        id: string
        price: string
        quantity?: number
      }
    }"
`;

