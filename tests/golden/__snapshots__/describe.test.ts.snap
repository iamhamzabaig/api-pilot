exports[`describe golden output > renders updateSubscription 1`] = `
"PATCH /v1/subscriptions/{subscription}
Updates an existing subscription to match the specified parameters.
id: updateSubscription · tags: Subscriptions · auth: bearerAuth (http: bearer)

path:
  subscription: string required

header:
  X-Idempotency-Key: string — A unique key to guarantee the request is only performed once.

body (application/json, required):
  {
    customer?: string
    cancel_at_period_end?: boolean
    proration_behavior?: "create_prorations" | "none" | "always_invoice"
    items?: array of {
      id?: string
      price?: string
      quantity?: number
    }
  }

responses:
  200 application/json
    {
      id: string
      customer: string | { created: …; updated?: …; id: …; email: …; name?: …; balance?: …; metadata?: … }
      status: "incomplete" | "trialing" | "active" | "past_due" | "canceled" | "unpaid"
      items: …[]
      cancel_at_period_end?: boolean
      current_period_end?: number
    }
  others: 404"
`;
