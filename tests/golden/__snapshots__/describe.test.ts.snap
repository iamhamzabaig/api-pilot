exports[`describe golden output > renders listCustomers 1`] = `
"GET /v1/customers
Returns a list of your customers.
id: listCustomers · tags: Customers · auth: bearerAuth (http: bearer)

query:
  limit: number — A limit on the number of objects to be returned, between 1 and 100.
  email: string(email) — A case-sensitive filter on the list based on the customer's email field.

responses:
  200 application/json
    {
      object: "list"
      data: array of {
        created: number
        updated?: number | null
        id: string
        email: string(email)
        name?: string | null
        balance?: number
        metadata?: { [key: string]: string }
      }
      has_more: boolean
    }
  others: 401"
`;

